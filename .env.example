# Server-side Google Gemini API key (obtain from https://aistudio.google.com/apikey)
# If omitted or empty, POST /api/coach answers 503 coach_unavailable (see COACH_ALLOW_FALLBACK).
GEMINI_API_KEY=

# Default Gemini model used by POST /api/coach for structured JSON language coaching
GEMINI_MODEL=gemini-3.8-flash

# "true" only on a developer machine or in tests: when Gemini is missing or fails, answer with a
# canned example marked «Пример ответа, ИИ не подключён». Never set on Vercel; there the learner
# sees an honest «Не получилось получить ответ» card instead.
COACH_ALLOW_FALLBACK=

# Local HTTP server port (used by `npm start`)
PORT=3000

# Public Supabase API URL (local default: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public Supabase anonymous key (copy from `npx supabase status -o env`)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server only, never in client code
SUPABASE_SERVICE_ROLE_KEY=

# "true" = login required for /api/coach (local Supabase / CI). Leave empty on Vercel until the EU cloud Supabase exists.
AUTH_ENABLED=

# "true" only on a developer machine. Never on Vercel Production (anyone who can reach the route
# could spend the owner's TTS credits; the rate limit is only 30 per 10 minutes per IP).
VOICE_LAB_ENABLED=

# comma-separated Gemini model ids to compare, from AI Studio docs
VOICE_LAB_MODELS=

# "true" only on a developer machine to enable /lab/nora preview. Never on Vercel.
NORA_LAB_ENABLED=

# "true" locally and on Vercel previews to include draft words/phrases before teacher review.
WORDS_SHOW_DRAFTS=

# Set to "false" to hide draft oral exam scenarios (drafts are shown by default with «Черновик, проверяется преподавателем» until teacher reviews).
SCENARIOS_SHOW_DRAFTS=

# TTS lab candidate voices: comma-separated provider:voice pairs
# Example: google:nb-NO-Chirp3-HD-Aoede,azure:nb-NO-PernilleNeural,elevenlabs:21m00Tcm4TlvDq8ikWAM
TTS_LAB_VOICES=

# Google Cloud Text-to-Speech API key (EU endpoint eu-texttospeech.googleapis.com)
GOOGLE_TTS_KEY=

# Azure AI Speech subscription key and region (Norway East: norwayeast)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=norwayeast

# ElevenLabs API key and optional base URL (EU residency: https://api.eu.residency.elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=
