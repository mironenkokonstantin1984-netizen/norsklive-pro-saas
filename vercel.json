{
  "version": 2,
  "redirects": [
    {
      "source": "/norsk",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/norsk/(.*)",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
