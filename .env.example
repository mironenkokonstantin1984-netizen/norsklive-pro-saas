# Server-side Google Gemini API key (obtain from https://aistudio.google.com/apikey)
# If omitted or empty, POST /api/coach falls back to the deterministic rule-based Norwegian engine.
GEMINI_API_KEY=

# Default Gemini model used by POST /api/coach for structured JSON language coaching
GEMINI_MODEL=gemini-2.5-flash

# Local HTTP server port (used by `npm start`)
PORT=3000

# Public Supabase API URL (local default: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public Supabase anonymous key (copy from `npx supabase status -o env`)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server only, never in client code
SUPABASE_SERVICE_ROLE_KEY=

# "true" = login required for /api/coach (local Supabase / CI). Leave empty on Vercel until the EU cloud Supabase exists.
AUTH_ENABLED=

# "true" only on a developer machine. Never on Vercel.
VOICE_LAB_ENABLED=

# comma-separated Gemini model ids to compare, from AI Studio docs
VOICE_LAB_MODELS=

# "true" only on a developer machine to enable /lab/nora preview. Never on Vercel.
NORA_LAB_ENABLED=

# "true" locally and on Vercel previews to include draft words/phrases before teacher review.
WORDS_SHOW_DRAFTS=


